# Existing Docker configuration; choose your own local SQL password.
SA_PASSWORD=replace-with-a-strong-local-password
DB_NAME=GarageSale
OPENAI_KEY=
ADMIN_REVIEW_OPENAI_PROMPT=

# Sandbox ONLY: copy the secret key from the selected Stripe sandbox.
# Leave blank until ready; no publishable key or Stripe.js is needed.
STRIPE_SECRET_KEY=
# Signing secret printed by the host-run `stripe listen` command (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Browser-facing origin. Both current Compose files publish HTTP port 8080.
# Never use http://garagesale:8080 or the container's internal address.
APP_BASE_URL=http://localhost:8080
