@page "/shopping-cart"
@rendermode InteractiveServer
@attribute [Authorize]
@using GarageSale.DTOs
@using GarageSale.Services
@using System.Security.Claims
@inject IShoppingCartService ShoppingCartService
@inject CartStateService CartStateService
@inject NavigationManager Navigation

<PageTitle>Shopping Cart</PageTitle>

<div class="container py-5">

    <h1 class="cart-page-heading">Shopping Cart</h1>

    @if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (_cartItems.Count == 0)
    {
        <div class="cart-empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" class="cart-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
            </svg>
            <p class="cart-empty-text">Your shopping cart is currently empty.</p>
            <a href="/" class="btn btn-primary mt-3">Continue Shopping</a>
        </div>
    }
    else
    {
        <CartItemList Items="_cartItems">
            <ItemActions Context="item">
                <button class="btn btn-outline-danger btn-sm"
                        @onclick="() => RemoveItem(item)"
                        disabled="@_removing">
                    Remove
                </button>
            </ItemActions>
        </CartItemList>

        <div class="cart-summary">
            <span class="cart-summary-label">Total</span>
            <span class="cart-summary-total">@FormatPrice(_cartItems.Sum(i => i.Price))</span>
        </div>

        <div class="cart-checkout-action">
            <button class="btn btn-primary btn-lg" @onclick="ProceedToCheckout">
                Proceed to Checkout
            </button>
        </div>
    }

</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<ShoppingCartItemsDto> _cartItems = [];
    private bool _isLoading = true;
    private bool _removing;
    private string? _userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState;
        _userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (_userId is not null)
            _cartItems = await ShoppingCartService.GetShoppingCartItems(_userId);

        _isLoading = false;
    }

    private async Task RemoveItem(ShoppingCartItemsDto item)
    {
        if (_userId is null || _removing)
            return;

        _removing = true;
        try
        {
            await ShoppingCartService.DeleteItemFromShoppingCart(item.ProductId, _userId);
            _cartItems.Remove(item);
            CartStateService.Decrement();
        }
        finally
        {
            _removing = false;
        }
    }

    private void ProceedToCheckout() => Navigation.NavigateTo("/checkout");

    private static string FormatPrice(int cents) =>
        (cents / 100m).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
}
